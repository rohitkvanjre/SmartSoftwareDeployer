{
  "PORTS": {
    "control": 5050,
    "discovery": 5051,
    "files": 5052
  },
  "TLS": {
    "server_cert": "data/cert.pem",
    "server_key": "data/key.pem"
  },
  "FTP": {
    "enabled": false,
    "secure": true,
